{
  "model_name": "yolov8n.pt",
  "confidence_threshold": 0.35,
  "nms_threshold": 0.45,
  "target_classes": {
    "0": "person",
    "2": "car",
    "3": "motorcycle",
    "5": "bus",
    "7": "truck"
  },
  "tracker": {
    "type": "bytetrack",
    "track_thresh": 0.4,
    "track_buffer": 30,
    "match_thresh": 0.8
  },
  "performance": {
    "max_fps": 30,
    "drop_frames_on_lag": true,
    "device": "cpu"
  }
}
