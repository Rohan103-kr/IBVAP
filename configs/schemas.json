{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IBVAP Data Contracts Schema",
  "description": "API & Event contracts for Intelligent Border Video Analytics Platform",
  "definitions": {
    "CameraMetadata": {
      "type": "object",
      "properties": {
        "camera_id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "stream_url": { "type": "string" },
        "status": { "type": "string", "enum": ["ONLINE", "DEGRADED", "OFFLINE"] },
        "fps": { "type": "number" },
        "resolution": {
          "type": "object",
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          },
          "required": ["width", "height"]
        }
      },
      "required": ["camera_id", "name", "stream_url", "status"]
    },
    "DetectionEvent": {
      "type": "object",
      "properties": {
        "camera_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "frame_id": { "type": "integer" },
        "object_type": { "type": "string", "enum": ["person", "vehicle", "car", "truck", "bus", "motorcycle"] },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x1, y1, x2, y2]"
        }
      },
      "required": ["camera_id", "timestamp", "object_type", "confidence", "bbox"]
    },
    "TrackedObject": {
      "type": "object",
      "properties": {
        "camera_id": { "type": "string" },
        "track_id": { "type": "integer" },
        "object_type": { "type": "string" },
        "confidence": { "type": "number" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "centroid": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "trajectory": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "velocity": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "first_seen": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" },
        "duration_sec": { "type": "number" }
      },
      "required": ["camera_id", "track_id", "object_type", "bbox", "centroid"]
    },
    "SecurityEvent": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string" },
        "event_type": { 
          "type": "string",
          "enum": ["PERSON_DETECTED", "VEHICLE_DETECTED", "ZONE_ENTRY", "FENCE_CROSSING", "NIGHT_MOVEMENT", "LOITERING", "CAMERA_OFFLINE"]
        },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "HIGH", "CRITICAL"] },
        "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "camera_id": { "type": "string" },
        "track_id": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "snapshot": { "type": "string", "description": "Base64 string or image filepath" }
      },
      "required": ["event_type", "severity", "risk_score", "camera_id", "timestamp", "reasons"]
    }
  }
}
